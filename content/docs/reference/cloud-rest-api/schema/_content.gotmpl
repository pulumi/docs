{{/*
    Content adapter: auto-generates one page per OpenAPI schema component.
    _index.md is preserved (it renders the component index).
*/}}

{{ $spec := index site.Data "openapi-spec" }}
{{ $lastmodData := site.Data.openapi_lastmod }}
{{ if not $lastmodData }}
    {{ warnf "openapi: data/openapi_lastmod.json not found — sitemap <lastmod> will be omitted for cloud-rest-api schema pages. Run 'node scripts/update-openapi-lastmod.js' to regenerate it." }}
{{ end }}
{{ if not $spec }}
    {{ warnf "openapi: data/openapi-spec.json not found — run 'make ensure' to download the spec. Skipping schema page generation." }}
{{ else }}

{{ $schemas := $spec.components.schemas }}

{{ $names := slice }}
{{ range $name, $_ := $schemas }}
    {{ $names = $names | append $name }}
{{ end }}
{{ $names = sort $names }}

{{ range $names }}
    {{ $name := . }}
    {{ $slug := $name | urlize }}

    {{/* Add an alias from the original CamelCase name so external links
         using the un-lowered form (e.g. /schema/AppStack/) don't 404.
         Use the raw $name (not urlize, which lowercases) for the alias. */}}
    {{ $aliases := slice }}
    {{ if ne $name ($name | lower) }}
        {{ $aliases = $aliases | append (printf "/docs/reference/cloud-rest-api/schema/%s/" $name) }}
    {{ end }}

    {{/* meta_desc: derive an entity-specific description from the component's own
         OpenAPI description instead of the name-only boilerplate below. Many
         components declare their real description one allOf/$ref hop away rather
         than on the component itself (the same composition schema-component.html
         already resolves for on-page rendering via openapi/resolve-schema.html).
         A single hop of $ref/allOf resolution is sufficient here: checked against
         a full-depth reference resolution offline, one hop already recovers a
         non-empty description for all 800 current components, so this stays a
         plain lookup rather than needing recursion. */}}
    {{ $schema := index $schemas $name }}
    {{ $desc := "" }}
    {{ if isset $schema "allOf" }}
        {{ range $schema.allOf }}
            {{ if eq $desc "" }}
                {{ if isset . "$ref" }}
                    {{ $refParts := split (index . "$ref") "/" }}
                    {{ $refName := index $refParts (sub (len $refParts) 1) }}
                    {{ with index $schemas $refName }}
                        {{ if .description }}
                            {{ $desc = .description }}
                        {{ else if isset . "allOf" }}
                            {{ range .allOf }}
                                {{ if and (eq $desc "") (not (isset . "$ref")) }}
                                    {{ with .description }}
                                        {{ $desc = . }}
                                    {{ end }}
                                {{ end }}
                            {{ end }}
                        {{ end }}
                    {{ end }}
                {{ else }}
                    {{ with .description }}
                        {{ $desc = . }}
                    {{ end }}
                {{ end }}
            {{ end }}
        {{ end }}
        {{ with $schema.description }}
            {{ $desc = . }}
        {{ end }}
    {{ else if isset $schema "$ref" }}
        {{ $refParts := split (index $schema "$ref") "/" }}
        {{ $refName := index $refParts (sub (len $refParts) 1) }}
        {{ with index $schemas $refName }}
            {{ $desc = .description | default "" }}
        {{ end }}
    {{ else }}
        {{ $desc = $schema.description | default "" }}
    {{ end }}

    {{ $metaDesc := printf "Schema reference for the %s component in the Pulumi Cloud REST API." $name }}
    {{ with $desc }}
        {{ $descClean := trim (replaceRE `\s+` " " .) " \t\n\r" }}
        {{ if $descClean }}
            {{/* truncate returns HTML-escaped text (e.g. an apostrophe becomes
                 "&#39;"); htmlUnescape reverses that so the stored param is plain
                 text, matching every other param on this page and avoiding a
                 double-escape (e.g. "&amp;#39;") when head.html renders it. */}}
            {{ $truncated := truncate 110 $descClean | htmlUnescape }}
            {{ $metaDesc = printf "%s Pulumi Cloud REST API schema: %s." $truncated $name }}
        {{ end }}
    {{ end }}

    {{ $params := dict
        "h1" $name
        "title_tag" (printf "Pulumi Cloud REST API schema: %s" $name)
        "meta_desc" $metaDesc
        "openapi_schema" true
        "schema_name" $name
        "notoc" true
    }}

    {{/* lastmod: see the pre-built-policy-packs adapter for why
         "dates.lastmod" must be paired with "params.no_authored_date" —
         same Hugo date-cascade / JSON-LD fabrication risk applies here. */}}
    {{ $dates := dict }}
    {{ with $lastmodData }}
        {{ if and (gt (len .schemas) 0) (not (isset .schemas $name)) }}
            {{/* Tripwire: the ledger has schema entries but none match this
                 adapter-derived schema name. Two distinct causes trip this
                 same warning: either the schema is new since the last
                 nightly ledger update (data/openapi_lastmod.json only
                 catches up when that job runs, while
                 data/openapi-spec.json is gitignored and re-downloaded by
                 `make ensure` on every build), or
                 scripts/update-openapi-lastmod.js and this template have
                 drifted apart on which schema keys exist. Warn once per
                 name so either case shows up in build output instead of
                 silently dropping <lastmod>/dateModified for the affected
                 pages. */}}
            {{ warnidf (printf "openapi-lastmod-schema-miss-%s" $name) "openapi: schema %q has no entry in data/openapi_lastmod.json (ledger has %d schemas) — this page will render without <lastmod>/dateModified. Either the schema is new since the last nightly ledger update, or scripts/update-openapi-lastmod.js's schema derivation has drifted from this template's." $name (len .schemas) }}
        {{ end }}
        {{ with index .schemas $name }}
            {{ with .lastmod }}
                {{ $dates = dict "lastmod" (time.AsTime .) }}
                {{ $params = merge $params (dict "no_authored_date" true) }}
            {{ end }}
        {{ end }}
    {{ end }}

    {{ $.AddPage (dict
        "path" $slug
        "title" $name
        "kind" "page"
        "aliases" $aliases
        "dates" $dates
        "params" $params
    ) }}
{{ end }}{{/* range $names */}}

{{ end }}{{/* if not $spec / else */}}
