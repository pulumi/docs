{{- /*
    Releases JSON feed -> /releases/index.json

    A single machine-readable document built from this section's pages
    (.RegularPagesRecursive — see content/releases/_index.md), emitted
    newest-first by date. One flat entry per page:
      { type: "release" | "changelog", title, date, url, description?,
        editions?, tiers?, body? }
    editions is the entry's `editions:` front matter: edition ids from
    data/pulumi_pricing.yaml ("business-critical"). tiers is the same list as
    display names ("Business Critical") -- the key this feed published before
    the rename, kept for one release cycle so external consumers can migrate.
    Drop `tiers` (and this note) once they have.
    description comes from the page's short_description (releases) or
    meta_desc (changelog items). body is the entry's rendered HTML content —
    the minimal fragment (no page chrome), with root-relative links and assets
    rewritten to absolute URLs so off-domain consumers resolve them. Present
    only when the page has a body (changelog items always do; full releases
    render from section params and usually don't).
    Mirrors layouts/index.json and the dict/slice/append + jsonify style of
    layouts/docs/list.llmsitemap.json.
*/ -}}
{{- $entries := slice -}}
{{- $base := strings.TrimSuffix "/" site.BaseURL -}}
{{- range .RegularPagesRecursive.ByDate.Reverse -}}
    {{- $type := cond (eq .Type "changelog") "changelog" "release" -}}
    {{- $entry := dict
        "type" $type
        "title" .Title
        "date" (.Date.Format "2006-01-02")
        "url" .Permalink -}}
    {{- with or .Params.short_description .Params.meta_desc -}}
        {{- $entry = merge $entry (dict "description" (. | markdownify | plainify | htmlUnescape | chomp | replaceRE "\\s+" " ")) -}}
    {{- end -}}
    {{- with .Params.editions -}}
        {{- $entry = merge $entry (dict "editions" .) -}}
        {{- $entry = merge $entry (dict "tiers" (partial "releases/edition-names.html" (dict "editions" . "where" $.RelPermalink))) -}}
    {{- end -}}
    {{- with .Content -}}
        {{- /* Absolutize root-relative links/assets ("/..."), skipping
             protocol-relative "//" URLs, so off-domain consumers resolve them. */ -}}
        {{- $body := . | chomp | replaceRE "(href|src)=\"/([^/])" (printf "${1}=\"%s/${2}" $base) -}}
        {{- $entry = merge $entry (dict "body" $body) -}}
    {{- end -}}
    {{- $entries = $entries | append $entry -}}
{{- end -}}

{{- dict
    "title" .Title
    "url" (absURL .RelPermalink)
    "entries" $entries
    | jsonify (dict "indent" "  ") -}}
