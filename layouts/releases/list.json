{{- /*
    Releases JSON feed -> /releases/index.json

    A single machine-readable document built from this section's pages
    (.RegularPagesRecursive — see content/releases/_index.md), emitted
    newest-first by date. One flat entry per page:
      { type: "release" | "changelog", title, date, url, description?, tiers? }
    description comes from the page's short_description (releases) or
    meta_desc (changelog items). Individual release cards and changelog bodies
    are not expanded here — follow each entry's url for the full content.
    Mirrors layouts/index.json and the dict/slice/append + jsonify style of
    layouts/docs/list.llmsitemap.json.
*/ -}}
{{- $entries := slice -}}
{{- range .RegularPagesRecursive.ByDate.Reverse -}}
    {{- $type := cond (eq .Type "changelog") "changelog" "release" -}}
    {{- $entry := dict
        "type" $type
        "title" .Title
        "date" (.Date.Format "2006-01-02")
        "url" .Permalink -}}
    {{- with or .Params.short_description .Params.meta_desc -}}
        {{- $entry = merge $entry (dict "description" (. | markdownify | plainify | htmlUnescape | chomp | replaceRE "\\s+" " ")) -}}
    {{- end -}}
    {{- with .Params.tiers -}}{{- $entry = merge $entry (dict "tiers" .) -}}{{- end -}}
    {{- $entries = $entries | append $entry -}}
{{- end -}}

{{- dict
    "title" .Title
    "url" (absURL .RelPermalink)
    "entries" $entries
    | jsonify (dict "indent" "  ") -}}
