{{/*
  Generated replacement for the formerly hand-maintained static/sitemap-index.xml.
  Rendered once on the home page (output format "sitemapindex", see
  config/_default/config.yml) to /sitemap-index.xml, the single entry point
  listed in robots.txt.

  <lastmod> is added only for /sitemap.xml, which this build actually produces
  and can date honestly via enableGitInfo (site.Lastmod = the max .Lastmod
  across all pages). /registry/sitemap.xml is built and deployed by
  pulumi/registry; this build has no reliable signal for when its content
  last changed, and per
  Google's sitemap guidance a missing lastmod is preferable to a fabricated
  one ("if your page changed 7 years ago, but you're telling us in the
  lastmod element that it changed yesterday, eventually we're not going to
  believe you anymore"). <lastmod> on a sitemapindex <sitemap> entry is
  optional per the sitemaps.org protocol, so omitting it here is valid.
*/ -}}
<?xml version="1.0" encoding="UTF-8"?>
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap>
    <loc>{{ .Site.Params.canonicalURL }}/sitemap.xml</loc>
    <lastmod>{{ safeHTML ( site.Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>
  </sitemap>
  {{/* Built and deployed separately by pulumi/registry; lastmod intentionally
       omitted, see comment above.

       NOTE: /registry/sitemap.xml is itself a <sitemapindex> (it fans out to
       dynamically-sharded /registry/sitemap-0.xml, -1.xml, ... as the
       registry grows past 45,000 URLs per shard) -- so referencing it here
       nests one sitemap index inside another, which the sitemaps.org
       protocol disallows ("You can not nest Sitemap index files.") and which
       not every crawler will recurse into. We keep this entry regardless:
       Google Search Console downloads it successfully with zero errors, so
       removing it would be a regression for the crawler that does handle it.
       To give the registry's 60k+ URLs a second, spec-compliant discovery
       path that does not depend on nesting, /registry/sitemap.xml is ALSO
       declared as its own top-level `Sitemap:` line directly in
       layouts/robots.txt -- do not "fix" this nesting by hardcoding the
       registry's leaf shard filenames here or in robots.txt; the shard
       count and names are dynamic and owned entirely by pulumi/registry's
       own build. */ -}}
  <sitemap>
    <loc>{{ .Site.Params.canonicalURL }}/registry/sitemap.xml</loc>
  </sitemap>
</sitemapindex>
