{{- $index := slice -}}
{{- range $page := $.Site.Pages -}}
    {{- $ancestors := slice -}}

    {{- range $a := $page.Ancestors.Reverse -}}
        {{ $ancestors = $ancestors | append $a.LinkTitle }}
    {{- end -}}

    {{- /* The home page has no HTML output anymore (it ships from marketing-web),
           so it has no content to index, and its .RelPermalink now resolves to
           this very output format's own path ("/index.json", since Hugo falls
           back to the first non-HTML outputs.home entry once HTML is dropped)
           rather than "/" -- indexing it would self-reference this file and
           crash scripts/search/page.js trying to read "index.json" as a page. */ -}}
    {{- if and (ne $page.File nil) (not $page.IsHome) -}}
        {{- $date := "" -}}
        {{- if and (eq $page.Section "blog") (not $page.Date.IsZero) -}}
            {{- $date = $page.Date.Format "Jan 2, 2006" -}}
        {{- end -}}
        {{-
            $index = $index | append (
                dict
                    "objectID" $page.File.UniqueID
                    "title" $page.Title
                    "section" $page.Section
                    "href" $page.RelPermalink
                    "params" $page.Params
                    "kind" $page.Kind
                    "date" $date
                    "ancestors" (after 1 $ancestors)
            )
        -}}
    {{- end -}}
{{- end -}}
{{- $index | jsonify (dict "indent" "    ") -}}
